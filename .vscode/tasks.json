{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-server-debug",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/DedicatedServer/DedicatedServer.sln",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-server-release",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/DedicatedServer/DedicatedServer.sln",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
